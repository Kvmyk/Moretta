# Moretta v0.9 — Environment Configuration
# Copy this file to .env and fill in the values.

# ─── Local Model (Ollama) ───────────────────────────────────────
LOCAL_MODEL=phi4-mini              # or phi3:mini for CPU-only servers
OLLAMA_URL=http://ollama:11434

# ─── Encryption at rest (REQUIRED) ─────────────────────────────
# Encrypts PII token maps, document text, chat history and stored blobs.
# Without it everything is written to data/*.db in plaintext.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this key makes existing records unreadable — re-key deliberately.
VAULT_ENCRYPTION_KEY=

# ─── External AI Provider Keys (configure what you need) ───────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=                 # https://openrouter.ai — single key for 200+ models

# ─── Default Provider ──────────────────────────────────────────
DEFAULT_PROVIDER=claude             # claude | openai | gemini | openrouter | ollama
# Must be an id present in backend/providers/models_registry.py, otherwise the
# registry default for DEFAULT_PROVIDER is used instead.
DEFAULT_AI_MODEL=claude-sonnet-4-6-20260217

# ─── Application ────────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=/app/data

# Browser origins allowed to call the API (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to true ONLY when the backend sits behind a trusted reverse proxy.
# When true, X-Forwarded-For is used as the client IP in the audit log.
TRUST_PROXY_HEADERS=false

# ─── Limits ─────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=26214400           # 25 MB
MAX_TEXT_CHARS=500000
DEEP_SCAN_MAX_CHARS=4000            # size of each deep-scan chunk
SESSION_TTL_SECONDS=3600            # document + PII mapping lifetime
TASK_RETENTION_SECONDS=2592000      # conversations purged after 30 days

# ─── SSO / Keycloak ─────────────────────────────────────────────
SSO_ENABLED=true
SSO_ISSUER_URL=http://keycloak:8080/auth/realms/moretta
SSO_ALLOWED_CLIENT_IDS=moretta-frontend
# Roles allowed to read the instance-wide audit log and dashboard.
SSO_ADMIN_ROLES=moretta-admin

# Keycloak admin bootstrap (docker-compose). No defaults are provided on
# purpose — compose refuses to start until you set them.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=

# Frontend OIDC client (build-time for Vite)
VITE_KEYCLOAK_URL=http://localhost:3000/auth
VITE_KEYCLOAK_REALM=moretta
VITE_KEYCLOAK_CLIENT_ID=moretta-frontend
